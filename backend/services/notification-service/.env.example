NODE_ENV=development
PORT=8003
REDIS_URL=redis://localhost:6379
NOTIFICATION_QUEUE=notification_queue

# Sender identity used for budget alerts.
SENDER_EMAIL=no-reply@example.com

# Leave SMTP settings blank for local development: emails are simulated in logs.
# Set all three values in production to send real email.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
